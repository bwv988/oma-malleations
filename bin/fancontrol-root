#!/usr/bin/env bash
# fancontrol-root - privileged half of the fancontrol tool.
#
# Installed root-owned at /usr/local/lib/oma-malleations/fancontrol-root.
# /etc/sudoers.d/oma-malleations-fancontrol lets the installing user run
# exactly these three commands without a password:
#
#   fancontrol-root up
#   fancontrol-root down
#   fancontrol-root auto
#
# fancontrol-guard.service runs `fancontrol-root guard`. `status` and
# --dry-run are read-only and can be run as the user.
#
# No user input reaches a shell. The only writes are "level 1".."level 7",
# "level auto", and "watchdog <seconds>" to /proc/acpi/ibm/fan.

set -euo pipefail

FAN_PROC=/proc/acpi/ibm/fan
HWMON_ROOT=/sys/class/hwmon
FAN_CONTROL_PARAM=/sys/module/thinkpad_acpi/parameters/fan_control
GUARD_UNIT=fancontrol-guard.service
LOCK_FILE=/run/fancontrol.lock
WATCHDOG_SECONDS=30
CRITICAL_TEMP=95
MIN_LEVEL=1
MAX_LEVEL=7
GUARD_INTERVAL=5
GUARD_AUTO_TICKS=6

usage() {
  cat <<'EOF'
usage: fancontrol-root up|down|auto|status|guard [--dry-run]

  up        raise the fan; from auto, take manual control at maximum
  down      lower the fan; below the temperature floor it writes auto
  auto      hand the fan back to the embedded controller
  status    print key=value state (read-only)
  guard     internal loop for fancontrol-guard.service
  --dry-run print the writes instead of performing them (read-only)
EOF
}

log() {
  printf 'fancontrol: %s\n' "$*" >&2
}

fan_control_state() {
  if [[ -r $FAN_CONTROL_PARAM ]]; then
    cat "$FAN_CONTROL_PARAM"
  else
    printf 'missing\n'
  fi
}

fan_control_enabled() {
  [[ -r $FAN_CONTROL_PARAM && $(<"$FAN_CONTROL_PARAM") == Y ]]
}

fan_field() {
  local key=$1 name value
  [[ -r $FAN_PROC ]] || return 0
  while read -r name value; do
    if [[ $name == "$key:" ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"$FAN_PROC"
  return 0
}

fan_level() { fan_field level; }
fan_speed() { fan_field speed; }
fan_status() { fan_field status; }

# Hottest of the CPU/board/NVMe sensors. Zeros and N/A entries are ignored.
# Returns 0 if no CPU/board sensor was readable; an NVMe reading alone is not
# enough to allow manual fan control.
max_temp() {
  local max=0 saw_cpu=0 d name f v
  for d in "$HWMON_ROOT"/hwmon*; do
    [[ -r $d/name ]] || continue
    name=$(<"$d/name") || continue
    case $name in
      coretemp|thinkpad|acpitz|nvme) ;;
      *) continue ;;
    esac
    for f in "$d"/temp*_input; do
      [[ -r $f ]] || continue
      v=$(<"$f") || continue
      [[ $v =~ ^[0-9]+$ ]] || continue
      v=$((10#$v))
      if (( v > 0 && v < 200000 )); then
        if (( v > max )); then
          max=$v
        fi
        case $name in
          coretemp|thinkpad|acpitz) saw_cpu=1 ;;
        esac
      fi
    done
  done
  if (( saw_cpu == 0 )); then
    printf '0\n'
  else
    printf '%d\n' $(((max + 500) / 1000))
  fi
}

# The manual floor for the current temperature. Level 1 is the lowest manual
# level this tool exposes; 0 (fan stopped) is left to the EC's auto mode.
required_level() {
  local temp=$1
  if (( temp >= 80 )); then
    printf '7\n'
  elif (( temp >= 77 )); then
    printf '6\n'
  elif (( temp >= 73 )); then
    printf '5\n'
  elif (( temp >= 68 )); then
    printf '4\n'
  elif (( temp >= 60 )); then
    printf '3\n'
  elif (( temp >= 50 )); then
    printf '2\n'
  else
    printf '1\n'
  fi
}

require_fan() {
  if [[ ! -e $FAN_PROC ]]; then
    log "no $FAN_PROC; is thinkpad_acpi loaded?"
    return 1
  fi
  if ! fan_control_enabled; then
    log "thinkpad_acpi fan_control is disabled ($(fan_control_state))."
    log "Enable it with /etc/modprobe.d/oma-malleations-fancontrol.conf, then reboot or:"
    log "  sudo modprobe -r thinkpad_acpi && sudo modprobe thinkpad_acpi"
    return 1
  fi
  return 0
}

write_level() {
  local target=$1
  case $target in
    auto | [1-7]) ;;
    *)
      log "refusing invalid fan level '$target'"
      return 1
      ;;
  esac
  if (( dry_run )); then
    printf 'would: echo level %s > %s\n' "$target" "$FAN_PROC"
    return 0
  fi
  if ! printf 'level %s\n' "$target" >"$FAN_PROC"; then
    log "failed to write level $target to $FAN_PROC"
    return 1
  fi
}

write_watchdog() {
  local seconds=$1
  [[ $seconds =~ ^[0-9]+$ ]] || return 1
  if (( dry_run )); then
    printf 'would: echo watchdog %s > %s\n' "$seconds" "$FAN_PROC"
    return 0
  fi
  # Not all ThinkPads support the watchdog; the guard is the primary safety
  # net, and this is the fallback if the guard stops.
  printf 'watchdog %s\n' "$seconds" >"$FAN_PROC" 2>/dev/null || true
}

lock_fan() {
  if ! exec 9>"$LOCK_FILE"; then
    log "cannot open $LOCK_FILE"
    return 1
  fi
  if ! flock -x 9; then
    log "cannot lock $LOCK_FILE"
    return 1
  fi
}

unlock_fan() {
  flock -u 9 2>/dev/null || true
}

start_guard() {
  if (( dry_run )); then
    printf 'would: systemctl start %s\n' "$GUARD_UNIT"
    return 0
  fi
  if ! systemctl start --no-block "$GUARD_UNIT" >/dev/null 2>&1; then
    log "could not start $GUARD_UNIT; the kernel watchdog will still return the fan to auto"
  fi
}

apply_manual() {
  local target=$1
  write_watchdog "$WATCHDOG_SECONDS" || true
  write_level "$target"
}

set_auto() {
  if ! fan_control_enabled; then
    # fan_control=N means the driver is already in auto; nothing to write.
    return 0
  fi
  write_level auto
  write_watchdog 0 || true
}

cmd_up() {
  local level temp req target
  if (( dry_run )); then
    if [[ ! -e $FAN_PROC ]]; then
      log "no $FAN_PROC; this is a simulation"
      return 1
    fi
    if ! fan_control_enabled; then
      log "note: fan_control is $(fan_control_state); this is a simulation"
    fi
  else
    require_fan || return 1
    lock_fan || return 1
  fi

  temp=$(max_temp)
  req=$(required_level "$temp")
  level=$(fan_level)

  if (( temp <= 0 )); then
    log "no valid temperature reading; refusing manual fan control"
    unlock_fan
    return 1
  fi

  if (( temp >= CRITICAL_TEMP )); then
    if ! set_auto; then
      unlock_fan
      return 1
    fi
    unlock_fan
    return 0
  fi

  case $level in
    auto)
      # The EC's auto level is not exposed. Only 7 is certain not to be a
      # decrease, so + from auto is a guaranteed boost.
      target=$MAX_LEVEL
      ;;
    full-speed | disengaged)
      # Already above the normal maximum; do not lower it.
      if (( dry_run )); then
        printf 'would: leave level %s (already above %s)\n' "$level" "$MAX_LEVEL"
      fi
      unlock_fan
      return 0
      ;;
    [0-7])
      target=$((level + 1))
      if (( target < req )); then target=$req; fi
      if (( target > MAX_LEVEL )); then target=$MAX_LEVEL; fi
      if (( target < MIN_LEVEL )); then target=$MIN_LEVEL; fi
      ;;
    *)
      target=$MAX_LEVEL
      ;;
  esac

  if ! apply_manual "$target"; then
    unlock_fan
    return 1
  fi
  unlock_fan
  start_guard
}

cmd_down() {
  local level temp req target speed
  if (( dry_run )); then
    if [[ ! -e $FAN_PROC ]]; then
      log "no $FAN_PROC; this is a simulation"
      return 1
    fi
    if ! fan_control_enabled; then
      log "note: fan_control is $(fan_control_state); this is a simulation"
    fi
  else
    require_fan || return 1
    lock_fan || return 1
  fi

  temp=$(max_temp)
  req=$(required_level "$temp")
  level=$(fan_level)
  speed=$(fan_speed)

  if (( temp <= 0 )); then
    log "no valid temperature reading; refusing manual fan control"
    unlock_fan
    return 1
  fi

  if (( temp >= CRITICAL_TEMP )); then
    if ! set_auto; then
      unlock_fan
      return 1
    fi
    unlock_fan
    return 0
  fi

  case $level in
    auto)
      if [[ $speed =~ ^[0-9]+$ ]] && (( speed == 0 )); then
        # The fan is already stopped; any manual level would be louder.
        if (( dry_run )); then
          printf 'would: leave level auto (fan is stopped)\n'
        fi
        unlock_fan
        return 0
      fi
      # From auto, - takes the quietest safe manual level.
      target=$req
      ;;
    full-speed | disengaged)
      target=$MAX_LEVEL
      if (( target < req )); then target=$req; fi
      ;;
    [0-7])
      target=$((level - 1))
      if (( target < req )); then
        if ! set_auto; then
          unlock_fan
          return 1
        fi
        unlock_fan
        return 0
      fi
      ;;
    *)
      if ! set_auto; then
        unlock_fan
        return 1
      fi
      unlock_fan
      return 0
      ;;
  esac

  if ! apply_manual "$target"; then
    unlock_fan
    return 1
  fi
  unlock_fan
  start_guard
}

cmd_auto() {
  if (( ! dry_run )); then
    lock_fan || return 1
  elif ! fan_control_enabled; then
    log "note: fan_control is $(fan_control_state); this is a simulation"
  fi
  if ! set_auto; then
    unlock_fan
    return 1
  fi
  unlock_fan
}

cmd_status() {
  local temp req level speed enabled guard
  temp=$(max_temp)
  req=$(required_level "$temp")
  level=$(fan_level)
  speed=$(fan_speed)
  enabled=$(fan_status)
  guard=inactive
  if systemctl is-active --quiet "$GUARD_UNIT" 2>/dev/null; then
    guard=active
  fi
  printf 'temp=%s\n' "$temp"
  printf 'required=%s\n' "$req"
  printf 'level=%s\n' "${level:-unknown}"
  printf 'fan=%s\n' "${speed:-unknown}"
  printf 'enabled=%s\n' "${enabled:-unknown}"
  printf 'guard=%s\n' "$guard"
  printf 'fan_control=%s\n' "$(fan_control_state)"
  printf 'watchdog=%s\n' "$WATCHDOG_SECONDS"
}

cmd_guard() {
  local idle=0 failures=0 level temp req enabled
  if ! fan_control_enabled; then
    log "fan_control disabled; guard not needed"
    return 0
  fi

  while :; do
    if ! lock_fan; then
      return 1
    fi
    if [[ ! -e $FAN_PROC ]]; then
      unlock_fan
      log "fan file disappeared; guard exiting"
      return 0
    fi

    temp=$(max_temp)
    req=$(required_level "$temp")
    level=$(fan_level)
    enabled=$(fan_status)

    if (( temp <= 0 )); then
      if [[ $level != auto ]]; then
        if set_auto; then
          log "no valid temperature reading; fan auto"
        fi
      fi
      unlock_fan
      return 0
    fi

    if (( temp >= CRITICAL_TEMP )); then
      if [[ $level != auto ]]; then
        if set_auto; then
          log "critical ${temp}C; fan auto"
          failures=0
        else
          failures=$((failures + 1))
        fi
      fi
      idle=0
    elif [[ $enabled != enabled ]]; then
      if apply_manual "$req"; then
        log "fan disabled at ${temp}C; level ${req}"
        failures=0
      else
        failures=$((failures + 1))
      fi
      idle=0
    elif [[ $level =~ ^[0-7]$ ]]; then
      if (( level < req )); then
        if apply_manual "$req"; then
          log "temperature ${temp}C needs level ${req}; raised from ${level}"
          failures=0
        else
          failures=$((failures + 1))
        fi
      else
        write_watchdog "$WATCHDOG_SECONDS" || true
        failures=0
      fi
      idle=0
    elif [[ $level == auto ]]; then
      idle=$((idle + 1))
    elif [[ $level == full-speed || $level == disengaged ]]; then
      write_watchdog "$WATCHDOG_SECONDS" || true
      idle=0
    else
      if set_auto; then
        log "unknown fan level '${level}'; set auto"
        failures=0
      else
        failures=$((failures + 1))
      fi
      idle=0
    fi

    unlock_fan

    if (( failures >= 3 )); then
      log "three write failures; giving up (the kernel watchdog should return the fan to auto)"
      return 0
    fi
    if (( idle >= GUARD_AUTO_TICKS )); then
      log "fan has been auto for $((GUARD_AUTO_TICKS * GUARD_INTERVAL))s; guard exiting"
      return 0
    fi
    sleep "$GUARD_INTERVAL"
  done
}

dry_run=0
mode=

for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=1 ;;
    up | down | auto | status | guard)
      if [[ -n $mode ]]; then
        usage >&2
        exit 2
      fi
      mode=$arg
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'fancontrol-root: unknown argument %q\n' "$arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z $mode ]]; then
  usage >&2
  exit 2
fi

if (( dry_run )) && [[ $mode == guard ]]; then
  log "--dry-run is not supported for guard"
  exit 2
fi

# Test hooks for the read-only modes. They are ignored for every write mode,
# so a preserved environment can never redirect a root write.
if (( dry_run )) || [[ $mode == status ]]; then
  FAN_PROC=${FAN_PROC_OVERRIDE:-$FAN_PROC}
  HWMON_ROOT=${HWMON_ROOT_OVERRIDE:-$HWMON_ROOT}
  FAN_CONTROL_PARAM=${FAN_CONTROL_PARAM_OVERRIDE:-$FAN_CONTROL_PARAM}
fi

# Guard test hook. guard is not allowed through the sudoers rule, and this
# script is not setuid, so this can only redirect a process the user already
# runs with their own privileges.
if [[ ${FANCONTROL_TEST:-0} == 1 && $mode == guard ]]; then
  FAN_PROC=${FAN_PROC_OVERRIDE:-$FAN_PROC}
  HWMON_ROOT=${HWMON_ROOT_OVERRIDE:-$HWMON_ROOT}
  FAN_CONTROL_PARAM=${FAN_CONTROL_PARAM_OVERRIDE:-$FAN_CONTROL_PARAM}
  LOCK_FILE=${LOCK_FILE_OVERRIDE:-$LOCK_FILE}
  GUARD_INTERVAL=${GUARD_INTERVAL_OVERRIDE:-$GUARD_INTERVAL}
fi

case $mode in
  up) cmd_up ;;
  down) cmd_down ;;
  auto) cmd_auto ;;
  status) cmd_status ;;
  guard) cmd_guard ;;
esac
