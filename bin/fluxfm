#!/usr/bin/env bash
# fluxfm - play FluxFM (Berlin) channels in cliamp
#
# Tracked in ~/Develop/oma-malleations. Installed as ~/.local/bin/fluxfm.
#
#   fluxfm                  play FluxFM Berlin 24/7
#   fluxfm 80s              play a channel by slug
#   fluxfm --list           list channel slugs
#   fluxfm --sync-playlist  write the all-channels playlist for the cliamp TUI
#
# If cliamp is already running the station is switched over its IPC socket
# (no new window). Otherwise cliamp is launched in a terminal with the station
# playing, matching the Omarchy TUI window class "cliamp".

set -euo pipefail

playlist_name="FluxFM"

# slug|label|stream url  (320 kbps MP3 unless the channel only offers less)
stations=(
  "berlin|FluxFM Berlin|https://streams.fluxfm.de/live/mp3-320/audio/"
  "alternative|FluxFM Alternative|https://streams.fluxfm.de/radioalt/mp3-320/streams.fluxfm.de/"
  "60s|FluxFM 60s|https://streams.fluxfm.de/60er/mp3-320/streams.fluxfm.de/"
  "70s|FluxFM 70s|https://streams.fluxfm.de/70er/mp3-320/audio/"
  "80s|FluxFM 80s|https://streams.fluxfm.de/80er/mp3-320/audio/"
  "chillhop|FluxFM ChillHop|https://streams.fluxfm.de/Chillhop/mp3-320/streams.fluxfm.de/"
  "chillout|FluxFM Chillout|https://streams.fluxfm.de/chillout/mp3-320/streams.fluxfm.de/"
  "indie-disco|FluxFM Indie Disco|https://streams.fluxfm.de/indiedisco/mp3-320/streams.fluxfm.de/"
  "clubsandwich|FluxFM Clubsandwich|https://streams.fluxfm.de/clubsandwich/mp3-320/audio/"
  "sound-of-berlin|FluxFM Sound of Berlin|https://streams.fluxfm.de/soundofberlin/mp3-320/audio/"
  "elektro|FluxFM Elektro|https://streams.fluxfm.de/elektro/mp3-320/audio/"
  "kompensator|FluxFM FluxKompensator|https://streams.fluxfm.de/fluxkompensator/mp3-320/audio/"
  "pop|FluxFM Pop Radio|https://streams.fluxfm.de/popradio/mp3-320/streams.fluxfm.de/"
  "kinder|FluxFM Kinder|https://streams.fluxfm.de/kinder1/mp3-128/streams.fluxfm.de/"
  "new-yorker|FluxFM New Yorker Instore|https://streams.fluxfm.de/nyir-ger/mp3-320/streams.fluxfm.de/"
)

lookup() {
  local want=$1 entry
  for entry in "${stations[@]}"; do
    IFS='|' read -r slug label url <<<"$entry"
    if [[ $slug == "$want" ]]; then
      printf '%s\n%s\n' "$label" "$url"
      return 0
    fi
  done
  return 1
}

list_stations() {
  local entry
  for entry in "${stations[@]}"; do
    IFS='|' read -r slug label url <<<"$entry"
    printf '%-15s %s\n' "$slug" "$label"
  done
}

config_dir="${CLIAMP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cliamp}"

sync_playlist() {
  local file="$config_dir/playlists/$playlist_name.toml" entry
  mkdir -p "$(dirname "$file")"
  {
    printf '# Generated by fluxfm --sync-playlist. Local edits are overwritten.\n'
    for entry in "${stations[@]}"; do
      IFS='|' read -r slug label url <<<"$entry"
      printf '\n[[track]]\npath = "%s"\ntitle = "%s"\n' "$url" "$label"
    done
  } >"$file.tmp"
  mv "$file.tmp" "$file"
  printf 'Wrote %s (%d channels)\n' "$file" "${#stations[@]}"
}

case "${1:-berlin}" in
  -h | --help | help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --list | -l | list)
    list_stations
    exit 0
    ;;
  --sync-playlist | sync-playlist)
    sync_playlist
    exit 0
    ;;
esac

slug=$1
if ! resolved=$(lookup "$slug"); then
  printf 'fluxfm: unknown channel %q\n\n' "$slug" >&2
  list_stations >&2
  exit 2
fi
label=$(sed -n 1p <<<"$resolved")
url=$(sed -n 2p <<<"$resolved")
uri="cliamp://play?url=$url"

if cliamp status >/dev/null 2>&1; then
  # A player is already running: hand the station to it, no new window.
  exec cliamp open "$uri"
fi

# Nothing running: start the TUI in a terminal with the station playing.
# omarchy-launch-tui passes argv through without a shell, so the URI is safe.
exec omarchy-launch-tui --app-id=cliamp cliamp open "$uri"
